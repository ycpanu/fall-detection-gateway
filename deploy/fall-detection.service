[Unit]
Description=Multimodal Edge Fall Detection Gateway
After=network-online.target sound.target
Wants=network-online.target

[Service]
Type=simple

User=orangepi
Group=orangepi

WorkingDirectory=/home/orangepi/projects/fall-detection-gateway

ExecStart=/home/orangepi/projects/fall-detection-gateway/bin/fall_detection_gateway

Environment="HOME=/home/orangepi"
Environment="PATH=/usr/local/bin:/usr/bin:/bin"
Environment="LD_LIBRARY_PATH=/home/orangepi/projects/fall-detection-gateway/lib:/usr/local/lib:/usr/lib/aarch64-linux-gnu"

Restart=on-failure
RestartSec=3

KillSignal=SIGTERM
TimeoutStopSec=15

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target